# Copy this file to .env and fill in real values. Never commit .env.
# Every variable maps to a field in src/attendance_ai/core/config.py; the commented ones show the default.

# ---------- Service ----------
# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO
# Signing key for tokens: at least 32 random characters.
JWT_SECRET=
JWT_TTL_MINUTES=60
# Development-only login for the seeded demo users. Must be false in prod.
AUTH_DEV_LOGIN_ENABLED=true
# Optional: when set (at least 8 characters), the demo sign-in also asks for this code. Use it for a
# shared public demo; leave it empty locally.
# DEMO_ACCESS_CODE=

# ---------- PostgreSQL: one URL per role (docs/design.md, section 11) ----------
# Admin: used only by scripts/db_setup.py to create the roles and the database.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:<password>@localhost:5432/postgres
# Owner: runs migrations and owns the tables.
DATABASE_OWNER_URL=postgresql+psycopg://ai_owner:<password>@localhost:5432/attendance_ai
# App: used by the API and the worker.
DATABASE_URL=postgresql+psycopg://ai_app:<password>@localhost:5432/attendance_ai
# Query: read-only role for LLM-written SQL.
DATABASE_QUERY_URL=postgresql+psycopg://ai_query:<password>@localhost:5432/attendance_ai
# Managed servers with few connections (for example 20 on a free tier) need a small pool.
# DB_POOL_SIZE=5
# DB_CONNECT_TIMEOUT_SECONDS=3

# ---------- Redis: job queue, answer cache, provider health ----------
REDIS_URL=redis://localhost:6379/0
WORKER_THREADS=2

# ---------- Ingestion ----------
# Where original uploads are kept (the API writes, the worker reads).
# STORAGE_DIR=var/storage
# UPLOAD_MAX_MB=20
# Tesseract executable for scanned PDFs; leave empty if `tesseract` is on the PATH (macOS, Linux).
# On Windows, usually C:\Program Files\Tesseract-OCR\tesseract.exe (see "Installing Tesseract" in the README).
TESSERACT_CMD=
# queue (default): the worker processes uploads from the Redis queue.
# inline: the upload request processes its own file, for hosts without a background worker (Vercel).
# INGESTION_MODE=queue

# ---------- Qdrant and the local embedding models ----------
# Without QDRANT_URL, document search is off and only structured (SQL) answers are available.
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION=attendance_chunks
# MODEL_CACHE_DIR=var/models
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# SPARSE_MODEL=Qdrant/bm25
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---------- LLM provider ----------
# openrouter (default) or openai. Without a key, questions get a controlled "provider unavailable" answer.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_FALLBACK_MODEL=openai/gpt-4.1-nano
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_OUTPUT_TOKENS=700

# ---------- Answers, feedback and exports ----------
# CACHE_TTL_SECONDS=3600
# QUERY_ROW_CAP=200
# EVIDENCE_ROW_CAP=2000
# Cosine similarity a question needs to an approved example's question for the example to apply.
# FEEDBACK_MIN_SIMILARITY=0.85
# EXPORT_ROW_CAP=10000
