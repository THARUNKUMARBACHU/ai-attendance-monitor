{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,docs/**,migrations/**,scripts/**,frontend/src/**,frontend/public/**,frontend/node_modules/**,sample_data/tenants/**,sample_data/expected/**,sample_data/generator/**,sample_data/schema/**,var/storage/**,dist/**}"
    }
  },
  "headers": [
    {
      "source": "/ui/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
