# Settings for the Docker Compose stack (docker-compose.yml). Copy this file to .env.docker, then
# change the passwords and JWT_SECRET. Never commit .env.docker.
#
# Everything runs locally: PostgreSQL, Redis and Qdrant are containers of this project. Do not paste
# the cloud settings from .env here. REDIS_URL, QDRANT_URL, QDRANT_API_KEY, STORAGE_DIR and
# MODEL_CACHE_DIR are set in docker-compose.yml so that they always point at those containers and
# at the image's folders; values for them in this file are ignored.

# ---------- Service ----------
# dev | test | prod. The demo sign-in below is refused when APP_ENV=prod.
APP_ENV=dev
LOG_LEVEL=INFO
# Token signing key, at least 32 characters. Replace this placeholder, for example with the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-docker-jwt-secret-0123456789
JWT_TTL_MINUTES=60
# Demo sign-in for the seeded users: the UI's user picker and scripts/load_samples.py need it.
AUTH_DEV_LOGIN_ENABLED=true

# ---------- PostgreSQL (the "postgres" container) ----------
# Use URL-safe passwords (letters, digits, "-", "_", "."), or percent-encode other characters.
#
# Superuser password of the local server: change me. It is applied only when the data volume is
# first created; to change it later, remove the volume (docker compose down -v deletes all data).
# DATABASE_ADMIN_URL below must use the same password.
POSTGRES_PASSWORD=change-me-postgres
# Admin: used only by the one-shot "setup" service (scripts/db_setup.py) to create the roles and the
# database. The API and the worker never receive it.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:change-me-postgres@postgres:5432/postgres
# Owner (runs the migrations; setup only), app (API and worker) and query (read-only, for LLM-written
# SQL). setup creates these roles with these passwords and resets them on every run: change me.
DATABASE_OWNER_URL=postgresql+psycopg://ai_owner:change-me-owner@postgres:5432/attendance_ai
DATABASE_URL=postgresql+psycopg://ai_app:change-me-app@postgres:5432/attendance_ai
DATABASE_QUERY_URL=postgresql+psycopg://ai_query:change-me-query@postgres:5432/attendance_ai
# Connections per pool; the API and the worker each have two pools (app and query roles).
DB_POOL_SIZE=5

# ---------- Worker and OCR ----------
WORKER_THREADS=2
# Tesseract inside the image (for scanned PDFs).
TESSERACT_CMD=/usr/bin/tesseract

# ---------- LLM provider (optional) ----------
# Without a key the service still runs: uploads, ingestion, records and the UI work, and every
# question gets a controlled "provider unavailable" answer. With a key, each question uses credits.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=openai/gpt-4.1-nano
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# With LLM_PROVIDER=openai, these are used instead:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
